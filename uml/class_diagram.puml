@startuml BitePlate_ClassDiagram
title BitePlate SRMS — Core Domain Class Diagram

left to right direction

scale 3000 width

skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam classFontSize 14
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #444444
skinparam classBorderThickness 1.5
skinparam classArrowThickness 1.5
skinparam classArrowColor #444444
skinparam packageStyle rectangle
skinparam packageBorderColor #888888
skinparam packageBorderThickness 1.5
skinparam packageFontSize 16
skinparam packageFontStyle bold
skinparam noteFontSize 12
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #888888
skinparam padding 8
skinparam defaultFontName Arial
skinparam defaultFontSize 14

' ═══════════════════════════════════════════════
' MENU DOMAIN
' Patterns: Factory Method, Decorator, Composite
' ═══════════════════════════════════════════════
package "Menu" #EFF5FB {

  interface MenuComponent <<interface>> {
    +getName() : String
    +getDescription() : String
    +getPrice() : BigDecimal
    +display() : void
  }

  abstract class MenuItem {
    #id : Long
    #name : String
    #description : String
    #price : BigDecimal
    #available : boolean
    #allergens : String
    +{abstract} getCategory() : String
    +getName() : String
    +getPrice() : BigDecimal
    +isAvailable() : boolean
  }

  class Starter {
    +getCategory() : String
  }
  class MainCourse {
    +getCategory() : String
  }
  class Dessert {
    +getCategory() : String
  }
  class Beverage {
    +getCategory() : String
  }

  class ComboMeal {
    -id : Long
    -name : String
    -price : BigDecimal
    -available : boolean
    +getName() : String
    +getPrice() : BigDecimal
    +display() : void
    +getItems() : List<MenuItem>
  }

  ' DECORATOR PATTERN
  abstract class MenuItemDecorator {
    #wrapped : MenuComponent
    +MenuItemDecorator(c : MenuComponent)
    +getName() : String
    +getPrice() : BigDecimal
    +display() : void
  }

  class AllergenFlagDecorator {
    -allergen : String
    +getDescription() : String
  }

  class SpecialPrepDecorator {
    -prepNote : String
    -surcharge : BigDecimal
    +getPrice() : BigDecimal
    +getDescription() : String
  }

  class SubstitutionDecorator {
    -substitution : String
    -priceDiff : BigDecimal
    +getPrice() : BigDecimal
    +getDescription() : String
  }

  ' FACTORY METHOD PATTERN
  abstract class MenuItemFactory {
    +{static} forCategory(category : String) : MenuItemFactory
    +{abstract} createAndValidate(name : String, price : BigDecimal) : MenuItem
    #validate(item : MenuItem) : void
  }

  class StarterFactory {
    +createAndValidate(name : String, price : BigDecimal) : Starter
  }
  class MainCourseFactory {
    +createAndValidate(name : String, price : BigDecimal) : MainCourse
  }
  class DessertFactory {
    +createAndValidate(name : String, price : BigDecimal) : Dessert
  }
  class BeverageFactory {
    +createAndValidate(name : String, price : BigDecimal) : Beverage
  }

  MenuItem          ..|> MenuComponent      : realises
  ComboMeal         ..|> MenuComponent      : realises
  MenuItemDecorator ..|> MenuComponent      : realises
  Starter           --|> MenuItem
  MainCourse        --|> MenuItem
  Dessert           --|> MenuItem
  Beverage          --|> MenuItem
  AllergenFlagDecorator  --|> MenuItemDecorator
  SpecialPrepDecorator   --|> MenuItemDecorator
  SubstitutionDecorator  --|> MenuItemDecorator
  MenuItemDecorator "1" o-- "1" MenuComponent : wraps
  ComboMeal "1" o-- "2..*" MenuItem          : contains
  StarterFactory     --|> MenuItemFactory
  MainCourseFactory  --|> MenuItemFactory
  DessertFactory     --|> MenuItemFactory
  BeverageFactory    --|> MenuItemFactory
  MenuItemFactory ..> MenuItem : <<creates>>
}

' ═══════════════════════════════════════════════
' TABLE DOMAIN
' Pattern: State
' ═══════════════════════════════════════════════
package "Table" #EBF5EB {

  enum TableStatus <<enumeration>> {
    FREE
    RESERVED
    OCCUPIED
    AWAITING_BILL
    CLEARED
  }

  ' STATE PATTERN
  interface TableState <<interface>> {
    +reserve(t : RestaurantTable) : void
    +occupy(t : RestaurantTable) : void
    +awaitBill(t : RestaurantTable) : void
    +clear(t : RestaurantTable) : void
  }

  class FreeState {
    +reserve(t : RestaurantTable) : void
    +occupy(t : RestaurantTable) : void
    +awaitBill(t : RestaurantTable) : void
    +clear(t : RestaurantTable) : void
  }
  class ReservedState {
    +reserve(t : RestaurantTable) : void
    +occupy(t : RestaurantTable) : void
    +awaitBill(t : RestaurantTable) : void
    +clear(t : RestaurantTable) : void
  }
  class OccupiedState {
    +reserve(t : RestaurantTable) : void
    +occupy(t : RestaurantTable) : void
    +awaitBill(t : RestaurantTable) : void
    +clear(t : RestaurantTable) : void
  }
  class AwaitingBillState {
    +reserve(t : RestaurantTable) : void
    +occupy(t : RestaurantTable) : void
    +awaitBill(t : RestaurantTable) : void
    +clear(t : RestaurantTable) : void
  }
  class ClearedState {
    +reserve(t : RestaurantTable) : void
    +occupy(t : RestaurantTable) : void
    +awaitBill(t : RestaurantTable) : void
    +clear(t : RestaurantTable) : void
  }

  class RestaurantTable {
    -id : Long
    -tableNumber : int
    -capacity : int
    -status : TableStatus
    -currentState : TableState
    -createdAt : LocalDateTime
    +reserve() : void
    +occupy() : void
    +awaitBill() : void
    +clear() : void
    -restoreState() : void
  }
  note bottom of RestaurantTable
    restoreState() annotated @PostLoad.
    Reconstructs transient TableState
    from persisted TableStatus after JPA load.
  end note

  FreeState         ..|> TableState
  ReservedState     ..|> TableState
  OccupiedState     ..|> TableState
  AwaitingBillState ..|> TableState
  ClearedState      ..|> TableState
  RestaurantTable "1" *-- "1" TableState : currentState
  RestaurantTable --> TableStatus
}

' ═══════════════════════════════════════════════
' STAFF DOMAIN
' Pattern: Inheritance + Polymorphism
' ═══════════════════════════════════════════════
package "Staff" #FEF9E7 {

  enum StaffRole <<enumeration>> {
    MANAGER
    HEAD_CHEF
    WAITER
    CASHIER
  }

  abstract class Staff {
    #id : Long
    #name : String
    #username : String
    #password : String
    #role : StaffRole
    #active : boolean
    #createdAt : LocalDateTime
    +{abstract} getPermissions() : Set<String>
    +hasPermission(p : String) : boolean
    +getAuthorities() : Collection<GrantedAuthority>
  }

  class Manager {
    +getPermissions() : Set<String>
  }
  class Chef {
    +getPermissions() : Set<String>
  }
  class Waiter {
    +getPermissions() : Set<String>
  }
  class Cashier {
    +getPermissions() : Set<String>
  }

  Manager --|> Staff
  Chef    --|> Staff
  Waiter  --|> Staff
  Cashier --|> Staff
  Staff --> StaffRole
}

' ═══════════════════════════════════════════════
' RESERVATION DOMAIN
' ═══════════════════════════════════════════════
package "Reservation" #F9EBEA {

  enum ReservationStatus <<enumeration>> {
    CONFIRMED
    CANCELLED
    COMPLETED
  }

  class Reservation {
    -id : Long
    -customerName : String
    -customerPhone : String
    -partySize : int
    -reservationTime : LocalDateTime
    -status : ReservationStatus
    -createdAt : LocalDateTime
  }

  Reservation --> ReservationStatus
  Reservation "0..*" --> "1" RestaurantTable : reserved for
}

' ═══════════════════════════════════════════════
' ORDER DOMAIN
' Pattern: Observer
' ═══════════════════════════════════════════════
package "Order" #F4ECF7 {

  enum OrderStatus <<enumeration>> {
    PENDING
    PREPARING
    READY
    SERVED
    CANCELLED
  }

  interface OrderSubject <<interface>> {
    +addObserver(o : OrderObserver) : void
    +removeObserver(o : OrderObserver) : void
    +notifyObservers(s : OrderStatus) : void
  }

  ' OBSERVER PATTERN — Observer interface
  interface OrderObserver <<interface>> {
    +onOrderStatusChanged(order : Order, status : OrderStatus) : void
  }

  ' OBSERVER PATTERN — ConcreteSubject
  class Order {
    -id : Long
    -notes : String
    -status : OrderStatus
    -createdAt : LocalDateTime
    -updatedAt : LocalDateTime
    -observers : List<OrderObserver>
    +addItem(item : OrderItem) : void
    +removeItem(item : OrderItem) : void
    +calculateSubtotal() : BigDecimal
    +updateStatus(s : OrderStatus) : void
    +addObserver(o : OrderObserver) : void
    +removeObserver(o : OrderObserver) : void
    +notifyObservers(s : OrderStatus) : void
  }

  class OrderItem {
    -id : Long
    -quantity : int
    -unitPrice : BigDecimal
    -customisations : String
    -allergenFlagged : boolean
    +getLineTotal() : BigDecimal
  }

  ' OBSERVER PATTERN — ConcreteObservers
  class WaiterNotifier {
    +onOrderStatusChanged(order : Order, status : OrderStatus) : void
  }
  class ManagerDashboard {
    +onOrderStatusChanged(order : Order, status : OrderStatus) : void
  }
  class KitchenDisplayObserver {
    +onOrderStatusChanged(order : Order, status : OrderStatus) : void
  }

  Order ..|> OrderSubject        : realises
  WaiterNotifier ..|> OrderObserver
  ManagerDashboard ..|> OrderObserver
  KitchenDisplayObserver ..|> OrderObserver
  Order "1" *-- "1..*" OrderItem : contains
  Order "1" o-- "0..*" OrderObserver : notifies
  Order "0..*" --> "1" RestaurantTable : placed at
  Order "0..*" --> "1" Staff         : taken by
  Order --> OrderStatus
  OrderItem "0..*" --> "1" MenuItem  : refers to
}

' ═══════════════════════════════════════════════
' KITCHEN DOMAIN
' Pattern: Command
' ═══════════════════════════════════════════════
package "Kitchen" #FDF2E9 {

  ' COMMAND PATTERN — Command interface
  interface KitchenCommand <<interface>> {
    +execute() : void
    +undo() : void
    +getDescription() : String
  }

  ' COMMAND PATTERN — ConcreteCommands
  class PrepareOrderCommand {
    -order : Order
    -previousStatus : OrderStatus
    +execute() : void
    +undo() : void
    +getDescription() : String
    +getOrder() : Order
  }
  class ExpediteOrderCommand {
    -order : Order
    -previousStatus : OrderStatus
    +execute() : void
    +undo() : void
    +getDescription() : String
    +getOrder() : Order
  }
  class CancelOrderCommand {
    -order : Order
    -previousStatus : OrderStatus
    +execute() : void
    +undo() : void
    +getDescription() : String
    +getOrder() : Order
  }
  class ServeOrderCommand {
    -order : Order
    -previousStatus : OrderStatus
    +execute() : void
    +undo() : void
    +getDescription() : String
    +getOrder() : Order
  }

  ' COMMAND PATTERN — Invoker
  class KitchenQueue <<Invoker>> {
    -commandHistory : Deque<KitchenCommand>
    +execute(cmd : KitchenCommand) : void
    +undoLastWithReload(repo : OrderRepository) : Optional<String>
    +hasCommands() : boolean
    +queueSize() : int
  }

  PrepareOrderCommand  ..|> KitchenCommand
  ExpediteOrderCommand ..|> KitchenCommand
  CancelOrderCommand   ..|> KitchenCommand
  ServeOrderCommand    ..|> KitchenCommand
  KitchenQueue "1" o-- "0..*" KitchenCommand : history (Deque)
  PrepareOrderCommand  --> Order : modifies
  ExpediteOrderCommand --> Order : modifies
  CancelOrderCommand   --> Order : modifies
  ServeOrderCommand    --> Order : modifies
}

' ═══════════════════════════════════════════════
' BILLING DOMAIN
' Patterns: Strategy, Facade
' ═══════════════════════════════════════════════
package "Billing" #E8F8F5 {

  ' STRATEGY PATTERN — Strategy interface
  interface PricingStrategy <<interface>> {
    +calculateTotal(order : Order) : BigDecimal
    +getStrategyName() : String
  }

  ' STRATEGY PATTERN — ConcreteStrategies
  class StandardPricingStrategy {
    +calculateTotal(order : Order) : BigDecimal
    +getStrategyName() : String
  }
  class HappyHourPricingStrategy {
    -{static} DISCOUNT : BigDecimal
    +calculateTotal(order : Order) : BigDecimal
    +getStrategyName() : String
  }
  class LoyaltyCardPricingStrategy {
    -{static} DISCOUNT : BigDecimal
    -{static} DRINK_CREDIT : BigDecimal
    +calculateTotal(order : Order) : BigDecimal
    +getStrategyName() : String
  }

  class TaxCalculator {
    -{static} VAT_RATE : BigDecimal
    +calculateTax(subtotal : BigDecimal) : BigDecimal
  }
  class TipHandler {
    +validateFixedTip(tip : BigDecimal) : BigDecimal
  }
  class SplitBillService {
    +calculatePerGuest(total : BigDecimal, guests : int) : BigDecimal
  }

  ' FACADE PATTERN
  class BillingFacade <<Facade>> {
    +generateBill(order : Order, strategy : PricingStrategy) : Bill
    +applyTip(billId : Long, tip : BigDecimal) : Bill
    +splitBill(billId : Long, guests : int) : Bill
    -appendToHistoryLog(order : Order, total : BigDecimal, strategy : PricingStrategy) : void
  }

  class Bill {
    -id : Long
    -subtotal : BigDecimal
    -tax : BigDecimal
    -tip : BigDecimal
    -total : BigDecimal
    -pricingStrategy : String
    -splitCount : int
    -paid : boolean
    -createdAt : LocalDateTime
    +addLineItem(desc : String, amount : BigDecimal) : void
  }

  class BillLineItem {
    -id : Long
    -description : String
    -amount : BigDecimal
  }

  StandardPricingStrategy    ..|> PricingStrategy
  HappyHourPricingStrategy   ..|> PricingStrategy
  LoyaltyCardPricingStrategy ..|> PricingStrategy
  BillingFacade *-- TaxCalculator   : owns
  BillingFacade *-- TipHandler      : owns
  BillingFacade *-- SplitBillService : owns
  BillingFacade ..> PricingStrategy  : <<uses>>
  BillingFacade ..> Bill             : <<creates>>
  BillingFacade --> Order            : reads
  Bill "1" *-- "1..*" BillLineItem   : contains
  Bill "1" --> "1" Order             : for
}

' ═══════════════════════════════════════════════
' HISTORY DOMAIN
' Patterns: Singleton, Iterator
' ═══════════════════════════════════════════════
package "History" #F2F3F4 {

  ' SINGLETON PATTERN
  class OrderHistoryLog <<Singleton>> {
    -{static} instance : OrderHistoryLog
    -records : List<OrderRecord>
    -OrderHistoryLog()
    +{static} getInstance() : OrderHistoryLog
    +append(record : OrderRecord) : void
    +getAll() : List<OrderRecord>
    +getOrdersInDateRange(from : LocalDate, to : LocalDate) : List<OrderRecord>
    +getOrdersByTable(tableNumber : int) : List<OrderRecord>
    +getMostFrequentlyOrderedItem() : String
    +loadFromDatabase(records : List<OrderRecord>) : void
    +iterator() : Iterator<OrderRecord>
    +size() : int
  }
  note right of OrderHistoryLog
    Double-checked locking:
    volatile instance + synchronized block.
    Backed by CopyOnWriteArrayList (thread-safe).
    {static} instance and {static} getInstance()
    are underlined per UML convention.
  end note

  class OrderRecord {
    -id : Long
    -orderId : Long
    -tableNumber : int
    -staffId : Long
    -staffName : String
    -itemsSummary : String
    -total : BigDecimal
    -pricingStrategy : String
    -recordedAt : LocalDateTime
  }

  ' ITERATOR PATTERN
  class OrderHistoryIterator {
    -snapshot : List<OrderRecord>
    -index : int
    +hasNext() : boolean
    +next() : OrderRecord
  }

  OrderHistoryLog "1" *-- "0..*" OrderRecord   : stores
  OrderHistoryLog ..> OrderHistoryIterator      : <<creates>>
  OrderHistoryIterator --> OrderRecord          : iterates
  BillingFacade ..> OrderHistoryLog             : <<uses (Singleton)>>
}

@enduml