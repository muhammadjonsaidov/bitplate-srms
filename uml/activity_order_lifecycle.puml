@startuml BitePlate_Activity_OrderLifecycle
title BitePlate SRMS — Full Order Lifecycle Activity Diagram

skinparam backgroundColor #FAFAFA
skinparam activityArrowThickness 1.5
skinparam activityFontSize 11
skinparam swimlaneBorderThickness 2

|#DDEEFF| Waiter |
|#DDFFDD| Kitchen (Head Chef) |
|#FFF8DC| System |
|#FFE4E1| Cashier |

|Waiter|
start

:Select available table;
note right
  GET /api/tables
  status = FREE
end note

:Seat customer;
note right
  PUT /api/tables/{id}/occupy
  TableState: FREE → OCCUPIED
end note

:Create new order\nPOST /api/orders;

|System|
:Register observers on Order\n(WaiterNotifier, ManagerDashboard,\nKitchenDisplayObserver);

|Waiter|
:Search menu;

repeat
  :Select menu item;

  |System|
  :MenuItemFactory.forCategory(category)\n→ StarterFactory / MainCourseFactory\n/ DessertFactory / BeverageFactory;

  if (Item has allergens?) then (yes)
    :Wrap with AllergenFlagDecorator;
    note right
      DECORATOR PATTERN
      Dynamically attaches
      allergen warning to item
    end note
  else (no)
  endif

  :Add OrderItem to Order\nPOST /api/orders/{id}/items;

  |Waiter|
  if (Add another item?) then (yes)
  else (no)
  endif

repeat while (Adding items?) is (yes)
→ (no)

:Submit order to kitchen\nPOST /api/orders/{id}/submit;

|System|
:KitchenQueue.execute(\n  new PrepareOrderCommand(order));
note right
  COMMAND PATTERN (Invoker)
  Stores command in Deque history
  for undo support
end note

:PrepareOrderCommand.execute()\n→ order.updateStatus(PREPARING);

:order.notifyObservers(PREPARING);

fork
  :WaiterNotifier → Redis Pub/Sub\nchannel: notifications:waiter;
fork again
  :ManagerDashboard → Redis Pub/Sub\nchannel: notifications:manager;
fork again
  :KitchenDisplayObserver → Redis Pub/Sub\nchannel: notifications:kitchen;
end fork
note right
  OBSERVER PATTERN
  All three observers notified
  concurrently via Redis Pub/Sub
end note

|Kitchen (Head Chef)|
:View kitchen queue\nGET /api/kitchen/queue;

if (Undo needed?) then (yes)
  :POST /api/kitchen/undo;
  note left
    KitchenQueue.undoLastWithReload()
    Reverts to previousStatus
  end note
else (no)
endif

:Cook food;

:Mark order ready\nPUT /api/kitchen/{id}/ready;

|System|
:KitchenQueue.execute(\n  new ExpediteOrderCommand(order));
:order.updateStatus(READY);
:order.notifyObservers(READY);

|Waiter|
:Receive READY notification;
:Deliver food to table;

:Request bill\n(Mark table AWAITING_BILL);
note right
  PUT /api/tables/{id}/await-bill
  TableState: OCCUPIED → AWAITING_BILL
end note

|Cashier|
:Select table from billing screen\nGET /api/billing/order/{orderId};

if (Generate bill) then (select strategy)
  if (Time 15:00–17:00 or AUTO?) then (Happy Hour)
    :strategy = HappyHourPricingStrategy\n(20% discount);
  elseif (Loyalty card?) then (Loyalty)
    :strategy = LoyaltyCardPricingStrategy\n(10% off + £3 credit);
  else (Standard)
    :strategy = StandardPricingStrategy;
  endif
endif

|System|
:BillingService.generateBill(orderId, strategy);

note right
  THREE-PATTERN COHERENT FLOW
  starts here:
end note

:COMMAND: KitchenQueue.execute(\n  new ServeOrderCommand(order))\n→ order.updateStatus(SERVED);

:STRATEGY: strategy.calculateTotal(order)\n→ subtotal;

:BillingFacade.generateBill(order, strategy);
:TaxCalculator.calculateTax(subtotal)\n→ tax (VAT 20%);
:Build Bill + BillLineItems;
:billRepository.save(bill);

:SINGLETON: OrderHistoryLog.getInstance()\n.append(orderRecord);
note right
  Record persisted to DB
  AND in-memory log updated
end note

|Cashier|
:Present bill to customer;

if (Apply tip?) then (yes)
  :PUT /api/billing/{id}/tip?tip=X;
else (no)
endif

if (Split bill?) then (yes)
  :PUT /api/billing/{id}/split?guests=N;
  note right
    SplitBillService.calculatePerGuest()
  end note
else (no)
endif

:Process payment;
:PUT /api/billing/{id}/pay;

|Waiter|
:Clear table\nPUT /api/tables/{id}/clear;
note right
  TableState: AWAITING_BILL → CLEARED → FREE
end note

stop

@enduml