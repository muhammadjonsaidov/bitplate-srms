@startuml BitePlate_ActivityDiagram_OrderLifecycle
title BitePlate SRMS — Full Order Lifecycle Activity Diagram

!pragma useVerticalIf on

scale 2800 width

<style>
activityDiagram {
  FontSize 20
  FontName Arial
  BackgroundColor #FFFFFF
  BorderColor #444444
  BorderThickness 2
  ArrowThickness 2
  Padding 20
}
diamond {
  FontSize 18
  BackgroundColor #FFFFFF
  BorderColor #444444
}
note {
  FontSize 16
  BackgroundColor #FFFBE6
  BorderColor #888888
}
</style>

skinparam swimlaneBorderThickness 2
skinparam swimlaneBorderColor #888888
skinparam swimlaneFontSize 26
skinparam swimlaneFontStyle bold
skinparam swimlaneBackgroundColor #FFFFFF
skinparam conditionStyle diamond

|Waiter|
|Kitchen (Head Chef)|
|System|
|Cashier|
|Manager|

|Waiter|
start

:View available tables;

:Seat customer;
note right: STATE: FreeState -> OccupiedState

:Create new order;

|System|
:Register observers on Order;
note right: OBSERVER: WaiterNotifier, ManagerDashboard, KitchenDisplayObserver

|Waiter|
:Browse menu;

repeat
  :Select menu item;
  note right: FACTORY METHOD: MenuItemFactory.forCategory()

  if (Allergens?) then (yes)
    :Wrap with AllergenFlagDecorator;
    note right: DECORATOR: allergen warning attached
  else (no)
  endif

  if (Special prep?) then (yes)
    :Wrap with SpecialPrepDecorator;
  else (no)
  endif

  :Add item to order;
repeat while (More items?) is (yes) not (no)

:Submit order to kitchen;

|System|
:KitchenQueue.execute(PrepareOrderCommand);
note right: COMMAND: stored in Deque, enables undo()

:order.updateStatus(PREPARING) + notifyObservers();
note right: OBSERVER: -> Redis notifications:waiter / :manager / :kitchen

|Kitchen (Head Chef)|
:View kitchen queue;

if (Undo?) then (yes)
  :KitchenQueue.undoLastWithReload();
else (no)
endif

:Cook food;

:Mark order ready;

|System|
:KitchenQueue.execute(ExpediteOrderCommand);

:order.updateStatus(READY) + notifyObservers();

|Waiter|
:Receive READY notification;

:Deliver food and mark table awaiting bill;
note right: STATE: OccupiedState -> AwaitingBillState

|Cashier|
if (Pricing strategy?) then (Happy Hour)
  :HappyHourPricingStrategy;
  note right: 20% discount
elseif (Loyalty card?) then (Loyalty Card)
  :LoyaltyCardPricingStrategy;
  note right: 10% off + 3 credit
else (Standard)
  :StandardPricingStrategy;
endif

|System|
:KitchenQueue.execute(ServeOrderCommand);
note right: COMMAND 1: order.updateStatus(SERVED)

:strategy.calculateTotal() + TaxCalculator.calculateTax();
note right: STRATEGY 2: algorithm swapped at runtime

:Build Bill; billRepository.save();

:OrderHistoryLog.getInstance().append(record);
note right: SINGLETON 3: double-checked locking, CopyOnWriteArrayList

|Cashier|
if (Tip?) then (yes)
  :Apply tip;
else (no)
endif

if (Split?) then (yes)
  :Split bill;
else (no)
endif

:Process payment;

|Waiter|
:Clear table;
note right: STATE: AwaitingBillState -> ClearedState -> FreeState

|Manager|
:Request order history;

|System|
:OrderHistoryLog.getInstance();
note right: SINGLETON: same instance

:iterator = instance.iterator();
note right: ITERATOR: OrderHistoryIterator with snapshot copy

repeat
  :record = iterator.next(); add to list;
repeat while (iterator.hasNext()?) is (yes) not (no)

:Return List<OrderRecord>;

|Manager|
if (Date filter?) then (yes)
  :Filter by date range;
else (no)
endif

if (Table filter?) then (yes)
  :Filter by table;
else (no)
endif

if (Most ordered?) then (yes)
  :getMostFrequentlyOrderedItem();
  note right: ITERATOR: traverses records, returns max count
else (no)
endif

stop

@enduml