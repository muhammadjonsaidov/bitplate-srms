@startuml BitePlate_Sequence_ThreePatternFlow
title BitePlate SRMS — Three-Pattern Coherent Flow\n(Command → Strategy → Singleton)\nSequence Diagram

skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderThickness 1.5
skinparam responseMessageBelowArrow true
skinparam sequenceFontSize 11

actor Cashier
participant "BillingController" as CTRL
participant "BillingService" as SVC
participant "KitchenQueue\n<<Invoker>>" as KQ
participant "ServeOrderCommand\n<<ConcreteCommand>>" as CMD
participant "Order\n<<ConcreteSubject>>" as ORD
participant "WaiterNotifier\n<<ConcreteObserver>>" as WN
participant "HappyHourPricingStrategy\n<<ConcreteStrategy>>" as PS
participant "BillingFacade\n<<Facade>>" as FAC
participant "TaxCalculator" as TAX
participant "OrderHistoryLog\n<<Singleton>>" as LOG

Cashier -> CTRL : POST /api/billing/generate/{orderId}?strategy=HAPPY_HOUR

activate CTRL
CTRL -> SVC : generateBill(orderId, "HAPPY_HOUR")
activate SVC

SVC -> SVC : order = orderRepository.findById(orderId)
note right of SVC
  Guard checks:
  order.status == CANCELLED
    → throw BadRequestException
  order.status == SERVED
    → skip command (idempotent)
end note

alt order.status != SERVED and != CANCELLED

  note over SVC, ORD #DDEEFF
    ① COMMAND PATTERN
    Cashier generating bill triggers
    ServeOrderCommand through KitchenQueue
    (Invoker) — stores undo history
  end note

  SVC -> ORD : addObserver(waiterNotifier)\naddObserver(managerDashboard)\naddObserver(kitchenDisplayObserver)
  activate ORD

  SVC -> KQ : execute(new ServeOrderCommand(order))
  activate KQ

  create CMD
  KQ -> CMD : new ServeOrderCommand(order)
  activate CMD

  CMD -> ORD : updateStatus(SERVED)
  note right of CMD
    previousStatus stored
    before change — enables undo()
  end note

  ORD -> ORD : status = SERVED\nupdatedAt = now()

  ORD -> WN : onOrderStatusChanged(order, SERVED)
  activate WN
  WN --> ORD : publish("notifications:waiter", msg)
  deactivate WN

  CMD --> KQ : void
  deactivate CMD

  KQ -> KQ : commandHistory.push(cmd)
  KQ --> SVC : void
  deactivate KQ

  SVC -> SVC : orderRepository.save(order)
  deactivate ORD

end

note over SVC, PS #DDFFDD
  ② STRATEGY PATTERN
  Algorithm selected at runtime —
  BillingFacade never changed
end note

SVC -> SVC : strategy = selectStrategy("HAPPY_HOUR")
note right of SVC
  "HAPPY_HOUR"   → happyHourPricing
  "LOYALTY_CARD" → loyaltyCardPricing
  default        → standardPricing
end note

SVC -> FAC : generateBill(order, happyHourPricingStrategy)
activate FAC

FAC -> PS : calculateTotal(order)
activate PS
note right of PS
  subtotal × 0.80
  (20% Happy Hour discount)
end note
PS --> FAC : subtotal : BigDecimal
deactivate PS

FAC -> TAX : calculateTax(subtotal)
activate TAX
note right of TAX
  subtotal × 0.20 (VAT)
end note
TAX --> FAC : tax : BigDecimal
deactivate TAX

FAC -> FAC : total = subtotal + tax\nbuild Bill + BillLineItems\nbillRepository.save(bill)

note over FAC, LOG #FFF3CD
  ③ SINGLETON PATTERN
  One global OrderHistoryLog instance
  receives the confirmed record
end note

FAC -> LOG : getInstance()
activate LOG
note right of LOG
  Double-checked locking:
  if(instance == null) {
    synchronized(class) {
      if(instance == null)
        instance = new ...
    }
  }
end note
LOG --> FAC : OrderHistoryLog instance

FAC -> LOG : append(OrderRecord)
note right of LOG
  historyRepository.save(record) ← DB
  records.add(record) ← CopyOnWriteArrayList
end note
LOG --> FAC : void
deactivate LOG

FAC --> SVC : Bill
deactivate FAC

SVC --> CTRL : Bill
deactivate SVC

CTRL --> Cashier : 201 Created\n{Bill JSON}
deactivate CTRL

@enduml